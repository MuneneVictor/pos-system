Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive application folders/files.
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^storage/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]

    # Block hidden files such as .env, .git, etc.
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<Files ".env">
    Require all denied
</Files>

<FilesMatch "\.(sql|log|ini|env|bak|dist)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
